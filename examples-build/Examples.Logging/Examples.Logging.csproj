    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../modules/howtos/examples/logging/*.cs" />
  </ItemGroup>

</Project>
